# Groq API key. Used only in server-side route handlers (Phase 1 onward) so it
# never reaches the browser. Free tier: https://console.groq.com/keys
# Put the real value in .env.local - this file is a committed template.
GROQ_API_KEY=

# Model used for the AI client on the other end of the phone. Must be fast and
# must NOT be a reasoning model: reasoning tokens share the completion budget
# and a capped reply comes back empty. Verified 2026-11-11.
GROQ_CLIENT_MODEL=qwen/qwen3.8-27b
# Model used for the scoring judge. A reasoning model is wanted here, and the
# route gives it room to think. Verified 2026-11-11.
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
