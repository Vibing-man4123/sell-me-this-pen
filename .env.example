# Groq API key. Used only in server-side route handlers (Phase 1 onward) so it
# never reaches the browser. Free tier: https://console.groq.com/keys
# Put the real value in .env.local - this file is a committed template.
GROQ_API_KEY=

# Model used for the AI client on the other end of the phone.
GROQ_CLIENT_MODEL=llama-3.3-70b-versatile
# Model used for the scoring judge. Can be the same; kept separate so the judge
# can be pinned to a stricter/slower model without changing call latency.
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile
